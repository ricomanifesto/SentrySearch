# SentrySearch Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Local API server
PORT=8001

# Database Configuration 
# Use local PostgreSQL for development, AWS RDS for production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentrysearch
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DEBUG=true

# Supabase Authentication
# Frontend uses the public anon key; backend uses the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter model configuration (requests use the native Chat Completions API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SENTRYSEARCH_MODEL=google/gemini-2.5-flash
SENTRYSEARCH_SYNTHESIS_MODEL=google/gemini-2.5-flash
SENTRYSEARCH_EVALUATION_MODEL=google/gemma-4-31b-it:free

# New report/evaluation admission: paused (default), legacy, or runtime.
# TODO(sentryruntime-cutover): Remove legacy mode after canary and rollback validation.
# Missing runtime settings never select legacy; pause leaves reads available.
SENTRYSEARCH_EXECUTION_MODE=paused
# In runtime mode select exactly one endpoint. Remote URLs require HTTPS.
SENTRYRUNTIME_LOCAL_URL=
SENTRYRUNTIME_URL=
# Optional explicit PEM trust bundle for the worker's HTTPS client.
# Empty uses HTTPX's default CA bundle, never SSL_CERT_FILE/SSL_CERT_DIR.
SENTRYRUNTIME_CA_FILE=
# Worker only: distinct tokens required remotely, optional together for local demos.
# Never commit values. The API only writes product outbox intent, not runtime requests.
SENTRYRUNTIME_PRODUCER_TOKEN=
SENTRYRUNTIME_WORKER_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8001

# AWS S3 Configuration
# Get these from your AWS account or Terraform outputs
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
S3_BUCKET_NAME=your-s3-bucket-name

# Application Configuration
ENVIRONMENT=development

# Enable/Disable Features
ENABLE_REPORT_STORAGE=true
ENABLE_TRACE_EXPORT=true
