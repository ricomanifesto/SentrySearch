# Used only by `docker build -f container/Dockerfile .`; the existing Railway
# build does not read this file. Allow only image inputs.
*
!pyproject.toml
!uv.lock
!.python-version
!run_api.py
!src/**
!release_cloudflare/__init__.py
!release_cloudflare/r2_client.py
!dev/run_runtime_worker.py
!dev/migrate_storage.py
!dev/prepare_service_volumes.py
!dev/check_worker_readiness.py
!certs/**
!container/build-requirements.txt
!container/liblzma/**
!deploy/cloudflare/sentrysearch_cloudflare/**
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
